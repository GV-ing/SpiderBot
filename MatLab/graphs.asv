% =========================================================================
% Script MATLAB per plottare Posizione, Velocità e Rotazione dal Workspace
% =========================================================================

% Assicurati di NON usare "clear all", altrimenti cancellerai le tue variabili!
close all; clc;

%% 1. Preparazione del vettore tempo
% Creiamo un vettore tempo fittizio in base al numero di campioni della variabile pos.
% Se hai già una variabile tempo reale nel workspace (es. 't'), sostituisci questa parte.
N_campioni = length(out.pos); 
dt = sim_ts; % Sostituisci con il tuo reale passo di campionamento (es. 0.01s = 100Hz)
t = out.tout;

pos_data = squeeze(out.pos);
vel_data = squeeze(out.vel);
rot_data = squeeze(out.rotation);
%% 2. Estrazione delle componenti (assumendo formato N x 3)
% Se le tue matrici sono 3 x N, scrivi ad esempio: pos_x = pos(1,:);
pos_x = pos(:, 1); pos_y = out.pos(:, 2); pos_z = out.pos(:, 3);
vel_x = out.vel(:, 1); vel_y = out.vel(:, 2); vel_z = out.vel(:, 3);
roll  = out.rotation(:, 1); pitch = out.rotation(:, 2); yaw = out.rotation(:, 3);

%% 3. Creazione della figura e dei grafici
fig = figure('Name', 'Analisi Cinematica (Dati Reali)', 'NumberTitle', 'off');
fig.Position = [100, 100, 800, 900]; % [sinistra, basso, larghezza, altezza]

% --- PRIMO GRAFICO: Posizione ---
subplot(3, 1, 1); 
plot(t, pos_x, 'r', 'LineWidth', 1.5); hold on;
plot(t, pos_y, 'g', 'LineWidth', 1.5);
plot(t, pos_z, 'b', 'LineWidth', 1.5);
grid on;
title('Posizione nel Tempo', 'FontSize', 14);
xlabel('Tempo [s]', 'FontSize', 12);
ylabel('Posizione [m]', 'FontSize', 12);
legend('x', 'y', 'z', 'Location', 'best');
set(gca, 'FontSize', 11);

% --- SECONDO GRAFICO: Velocità ---
subplot(3, 1, 2); 
plot(t, vel_x, 'r', 'LineWidth', 1.5); hold on;
plot(t, vel_y, 'g', 'LineWidth', 1.5);
plot(t, vel_z, 'b', 'LineWidth', 1.5);
grid on;
title('Velocità nel Tempo', 'FontSize', 14);
xlabel('Tempo [s]', 'FontSize', 12);
ylabel('Velocità [m/s]', 'FontSize', 12);
legend('v_x', 'v_y', 'v_z', 'Location', 'best');
set(gca, 'FontSize', 11);

% --- TERZO GRAFICO: Rotazione ---
subplot(3, 1, 3); 
plot(t, roll, 'r', 'LineWidth', 1.5); hold on;
plot(t, pitch, 'g', 'LineWidth', 1.5);
plot(t, yaw, 'b', 'LineWidth', 1.5);
grid on;
title('Rotazione nel Tempo (Roll, Pitch, Yaw)', 'FontSize', 14);
xlabel('Tempo [s]', 'FontSize', 12);
ylabel('Angolo [rad o deg]', 'FontSize', 12);
legend('Roll (r)', 'Pitch (p)', 'Yaw (y)', 'Location', 'best');
set(gca, 'FontSize', 11);

% (Opzionale) Salva il grafico
% exportgraphics(fig, 'cinematica_reale.pdf', 'ContentType', 'vector');