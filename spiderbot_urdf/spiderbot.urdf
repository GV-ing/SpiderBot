      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="models/Leg_A.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>

  <joint name="FR_femur_joint" type="revolute">
    <parent link="FR_leg_a"/>
    <child link="FR_leg_b"/>
    <origin xyz="0.00 0.03 -0.005" rpy="0 0 3.14159"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
  </joint>

  <link name="FR_leg_b">
    <inertial>
      <origin xyz="0 -0.016 0" rpy="0 0 0"/>
