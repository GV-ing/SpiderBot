    <child link="FR_leg_c"/>
    <origin xyz="0 -0.085 0" rpy="0 0 1.5708"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="10" velocity="3"/>
  </joint>

  <link name="FR_leg_c">
